\par ```python\line def parse\\_skill\\_file(markdown\\_text):\line     """\line     Convert natural language skill file to executable rules.\line     """\line     \line     # Step 1: Extract metadata\line     metadata = \{\line         "skill\\_name": extract
\\_header(markdown\\_text),\line         "when\\_to\\_apply": extract\\_section(markdown\\_text, "When to Apply"),\line         "version": extract\\_version(markdown\\_text),\line         "last\\_updated": extract\\_date(markdown\\_text)\line     \}\line 
    \line     # Step 2: Extract rules (each ### Rule is one rule)\line     rules = \\[]\line     for rule\\_section in split\\_by\\_heading(markdown\\_text, level=3):\line         rule\\_name = extract\\_title(rule\\_section)\line         \line 
        # Sub-parse: Extract conditions and actions\line         rule\\_obj = \{\line             "name": rule\\_name,\line             "conditions": extract\\_list\\_items(rule\\_section),\line             "actions": extract\\_instructions(rule\\
_section),\line             "examples": extract\\_code\\_blocks(rule\\_section)\line         \}\line         \line         rules.append(rule\\_obj)\line     \line     # Step 3: Extract metrics (how to measure success)\line     metrics = \\[]\line 
    if "Quality Metrics" in markdown\\_text:\line         metrics\\_section = extract\\_section(markdown\\_text, "Quality Metrics")\line         metrics = extract\\_list\\_items(metrics\\_section)\line     \line 
    # Step 4: Extract feedback triggers (when to revise this skill)\line     feedback\\_triggers = \\[]\line     if "Feedback Triggers" in markdown\\_text:\line         triggers\\_section = extract\\_section(markdown\\_text, "Feedback Triggers")\line 
        for trigger in split\\_by\\_pattern(triggers\\_section, "IF:"):\line             trigger\\_obj = \{\line                 "condition": extract\\_between\\_tags(trigger, "IF:", "THEN:"),\line                 "action": extract\\_after\\
_tag(trigger, "THEN:")\line             \}\line             feedback\\_triggers.append(trigger\\_obj)\line     \line     # Step 5: Return structured skill object\line     return SkillObject(\line         metadata=metadata,\line         rules=rules,\line 
        metrics=metrics,\line         feedback\\_triggers=feedback\\_triggers\line     )\line \line \line class SkillObject:\line     """Executable skill representation."""\line     \line     def \\_\\_init\\_\\_(self, metadata, rules, metrics, feedback\\
_triggers):\line         self.metadata = metadata\line         self.rules = rules\line         self.metrics = metrics\line         self.feedback\\_triggers = feedback\\_triggers\line     \line     def apply\\_to\\_generation(self, section\\
_draft, generation\\_context):\line         """\line         Apply this skill to a generated monograph section.\line         \line         Returns:\line         - validation\\_results: Pass/Fail + detailed feedback\line         - improved\\
_section: Auto-corrected section (if needed)\line         """\line         \line         # For each rule, check compliance\line         validation\\_results = \{\line             "overall\\_pass": True,\line             "rule\\_results": \\[],\line 
            "suggestions": \\[]\line         \}\line         \line         for rule in self.rules:\line             # Check if rule applies (e.g., "only for adverse events >5%")\line             if self.\\_rule\\_applies(rule, section\\_draft):\line 
                compliance = self.\\_check\\_rule\\_compliance(\line                     rule, \line                     section\\_draft, \line                     generation\\_context\line                 )\line                 \line 
                validation\\_results\\["rule\\_results"].append(\{\line                     "rule\\_name": rule\\["name"],\line                     "compliant": compliance\\["passed"],\line                     "details": compliance\\["details"],\line 
